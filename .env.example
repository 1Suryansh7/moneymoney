# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Stage 0 needs no key: scripts/check_models.py only verifies that the
# GEMINI_* capability aliases resolve, without any network call.
GEMINI_API_KEY=
# Optional overrides for config/models.json capability aliases:
# GEMINI_STRONG_MODEL=
# GEMINI_FAST_MODEL=
